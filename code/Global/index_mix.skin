<?xml version="1.0"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
 <head>
  <!-- meta http-equiv="Content-Language" content="en-us" / -->
  <!-- meta HTTP-EQUIV="REFRESH" content="1; url=http://www.beagleboard.org" -->
  <meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1" />
  <link rel="stylesheet" type="text/css" href="/static/default.css" />
  <link href="http://feeds.feedburner.com/BeagleBoard" rel="alternate" title="Beagle Board news feed" type="application/atom+xml" />
  <link rel="icon" href="/static/beagle.ico" type="image/x-icon" />
  <link rel="shortcut icon" href="/static/beagle.ico" type="image/x-icon" />
  <title>BeagleBoard.org - <% response.title %></title>
 </head>
 <body>
  <div id="outerframe">
   <div class="box">
    <div class="backgroundbottomright">
     <table width="963" cellpadding="0" cellspacing="0"><tr><td>
      <div class="head">
       <div class="nav">
        <div class="alist">
         <ul>
          <li><a href="/about">About Us</a></li>
          <li><a href="/support">Support</a></li>
          <li><a href="/chat">Live Chat</a></li>
          <li><a href="/discuss">Discussion Groups</a></li>
          <li class="last"><a href="/projects">Join Projects</a></li>
         </ul>
        </div><!-- alist -->
        <div class="alist"><% User.prompt %></div>
       </div><!-- nav -->
       <div class="breadcrumb">
        <p><a href="http://BeagleBoard.org">BeagleBoard.org</a></p>
       </div><!-- breadcrumb -->
      </div><!-- head -->
      <div class="body">
       <div class="navpanel">
        <div class="backgroundbottomright">
         <div class="navpanelhead">
          <h2>Nav Heading</h2>
         </div>
         <div class="navpanelbody">
          <ul>
           <li>line1</li>
           <li>line2</li>
           <li>line3</li>
          </ul>
         </div><!-- navpanelbody -->
        </div><!-- backgroundbottomright -->
       </div><!-- navpanel -->
       <div class="page">
        <% response.body %>
       </div>
       <div class="footer">
        <table border="0" width="98%" id="table4" cellspacing="10" cellpadding="0">
         <tr>
          <td valign="top">
           <img border="0" src="/static/images/88x31.png" 
            width="88" height="31" alt="Creative Commons-Attribution-Share Alike" />
          </td>
          <td valign="top">
           <div class="alist">
            <ul>
             <li><a href="/about">About Us</a></li>
             <li><a href="/support">Support</a></li>
             <li><a href="/chat">Live Chat</a></li>
             <li><a href="/discuss">Discussion</a></li>
             <li class="last"><a href="/projects">Join Projects</a></li>
            </ul>
            <br />
            <ul>
             <li>Under license from Creative Commons</li>
             <li><a href="/privacy">Privacy Policy</a></li>
             <li><a href="http://validator.w3.org/check/referer">Validate XHTML</a></li>
             <li><a href="http://jigsaw.w3.org/css-validator/check/referer">Validate CSS</a></li>
             <li class="last"><a href="/terms">Terms of Use</a></li>
            </ul>
           </div>
          </td>
         </tr>
        </table>
       </div><!-- footer -->
      </div><!-- body -->
     </td></tr></table>
    </div><!-- backgroundbottomright -->
   </div><!-- box -->
  </div><!-- outerframe -->
 </body>
</html>

